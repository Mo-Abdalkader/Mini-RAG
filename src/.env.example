APP_NAME = "mini-RAG"
APP_VERSION = "0.1"

FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE = 10

FILE_DEFAULT_CHUNK_SIZE = 512000 # 512KB

MONGODB_URL = "mongodb://admin:admin@localhost:27007" # ://username:password@localhost:port
MONGODB_DATABSE = "mini-rag"

# ================== LLM Config =====================
GENERATION_BACKEND = "COHERE" # 'OPENAI' # these values should be exactly the same as the types in the 'LLMEnums'
EMBEDDING_BACKEND = "COHERE"

OPENAI_API_KEY = 
OPENAI_API_URL = 

COHERE_API_KEY = 

GROQ_API_KEY = 

GENERATION_MODEL_ID = "command-a-03-2025"
EMBEDDING_MODEL_ID  = "embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE = 384

INPUT_DEFAULT_MAX_CHARACTERS = 1024
GENERATION_DEFAULT_MAX_TOKENS = 200
GENERATION_DEFAULT_TEMPERATURE = 0.1

# ================== Vector DB Config =====================
VECTOR_DB_BACKEND = "QDRANT"
VECTOR_DB_PATH = "qdrant_db"
VECTOR_DB_DISTANCE_METHOD = "cosine"

# ================== Templete configs =====================
PRIMARY_LANG = "en"
DEFAULT_LANG = "en"