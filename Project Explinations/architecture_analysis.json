  "execution_flow": [
    {
      "flow_name": "Application Startup",
      "steps": [
        "1. FastAPI app starts in main.py",
        "2. startup_db_client() connects to MongoDB using Motor",
        "3. Registers base_router and data_router"
      ]
    },
    {
      "flow_name": "File Upload Flow",
      "steps": [
        "1. Client calls POST /api/v1/data/upload/{project_id}",
        "2. upload_data receives project_id and UploadFile",
        "3. Creates/gets project via ProjectModel.get_project_or_create_one",
        "4. Validates file via DataController.validate_uploaded_file",
        "5. Generates unique file path via DataController.generate_unique_filepath",
        "6. Writes file to disk using aiofiles",
        "7. Creates Asset record in MongoDB via AssetModel.create_asset",
        "8. Returns JSONResponse with file_id"
      ]
    },
    {
      "flow_name": "File Processing Flow",
      "steps": [
        "1. Client calls POST /api/v1/data/process/{project_id} with ProcessRequest",
        "2. process_endpoint receives project_id and ProcessRequest",
        "3. Creates/gets project via ProjectModel.get_project_or_create_one",
        "4. Initializes ProcessController with project_id",
        "5. Loads file content via ProcessController.get_file_content (uses LangChain)",
        "6. Chunks content via ProcessController.process_file_content (uses RecursiveCharacterTextSplitter)",
        "7. Optionally deletes existing chunks if do_reset=1",
        "8. Inserts new chunks via ChunkModel.insert_many_chunks (batch insert)",
        "9. Returns JSONResponse with inserted_chunks count"
      ]
    },
