{
  "project_overview": {
    "name": "Mini-RAG",
    "type": "FastAPI Backend Service",
    "purpose": "A minimal Retrieval-Augmented Generation (RAG) system for document-based question answering. Handles document upload, processing, text chunking, and MongoDB storage.",
    "main_features": [
      "Document Upload API (.txt and .pdf files)",
      "Document Processing using LangChain loaders",
      "Text Chunking using RecursiveCharacterTextSplitter",
      "Project Management with MongoDB",
      "File Validation (type and size)"
    ],
    "high_level_architecture": "MVC Pattern - Routes (API), Controllers (Business Logic), Models (Data Layer)",
    "framework": "FastAPI + Motor (Async MongoDB)",
    "database": "MongoDB",
    "key_dependencies": ["FastAPI", "Motor", "LangChain", "PyMuPDF", "Pydantic", "aiofiles"]
  },
